// NISHETA eSPORTS HUB — Phase 1 schema
// Расширяется в Phase 2 (Match, MatchPlayer, Hero, GameAccount) и далее.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id                    String           @id @default(cuid())
  slug                  String           @unique // используется в URL /players/[slug]
  nickname              String
  realName              String?
  avatarUrl             String?
  mainRole              Role?
  secondaryRoles        Role[]
  steamId               String?          @unique // Steam64 ID или временно vanity-имя до первой синхронизации
  bio                   String?
  availability          String           @default("unknown") // unknown | today | evening | away
  availabilityUpdatedAt DateTime?
  notifyDota            Boolean          @default(true)
  notifyCs2             Boolean          @default(true)
  notifyNeedOne         Boolean          @default(true)
  notifyRecaps          Boolean          @default(true)
  notificationWindow    String           @default("any") // any | evening
  isActive              Boolean          @default(true)
  telegramChatId        String?          @unique
  telegramLinkCode      String?          @unique
  telegramLinkExpiry    DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  matches               MatchPlayer[]

  lobbyEntries          LobbyPlayer[]
  gameCalls             GameCall[]
  gameCallEntries       GameCallPlayer[]
}

model GameCall {
  id            String           @id @default(cuid())
  game          String // "DOTA2" | "CS2"
  creatorId     String
  creator       Player           @relation(fields: [creatorId], references: [id])
  playersNeeded Int
  startTime     DateTime
  note          String?
  status        String           @default("waiting") // waiting | ready | cancelled | expired
  recapMatchId  String?
  completedAt   DateTime?
  createdAt     DateTime         @default(now())
  participants  GameCallPlayer[]
}

model GameCallPlayer {
  id         String   @id @default(cuid())
  gameCallId String
  gameCall   GameCall @relation(fields: [gameCallId], references: [id])
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id])
  joinedAt   DateTime @default(now())

  @@unique([gameCallId, playerId])
}

model Lobby {
  id        String        @id @default(cuid())
  createdAt DateTime      @default(now())
  status    String        @default("active") // active | archived
  players   LobbyPlayer[]
}

model LobbyPlayer {
  id         String  @id @default(cuid())
  lobbyId    String
  lobby      Lobby   @relation(fields: [lobbyId], references: [id])
  playerId   String
  player     Player  @relation(fields: [playerId], references: [id])
  position   Int? // 1-5
  team       String?
  ready      Boolean @default(false)
  heroName   String?
  buildItems String?

  @@unique([lobbyId, playerId])
}

model Match {
  id         String        @id // Dota match_id как строка
  startTime  DateTime
  duration   Int // секунды
  radiantWin Boolean
  createdAt  DateTime      @default(now())
  players    MatchPlayer[]
}

model MatchPlayer {
  id        String  @id @default(cuid())
  matchId   String
  match     Match   @relation(fields: [matchId], references: [id])
  playerId  String
  player    Player  @relation(fields: [playerId], references: [id])
  heroId    Int
  heroName  String
  isRadiant Boolean
  win       Boolean
  kills     Int
  deaths    Int
  assists   Int
  gpm       Int
  xpm       Int
  lastHits  Int

  @@unique([matchId, playerId])
}

model DraftSession {
  id         String        @id @default(cuid())
  title      String
  status     String        @default("active") // active | completed | archived
  activeSide String        @default("radiant") // radiant | dire
  turnNumber Int           @default(1)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  actions    DraftAction[]
}

model DraftAction {
  id         String       @id @default(cuid())
  sessionId  String
  session    DraftSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  actionType String // pick | ban
  side       String // radiant | dire
  heroId     Int
  heroName   String
  role       String?
  turnNumber Int
  createdAt  DateTime     @default(now())

  @@index([sessionId, turnNumber])
}

model CsProfile {
  id               String           @id @default(cuid())
  playerId         String           @unique
  faceitNickname   String?
  faceitPlayerId   String?
  connectionStatus String           @default("unlinked") // unlinked | ready | synced | error
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  snapshots        CsStatSnapshot[]
}

model CsStatSnapshot {
  id         String    @id @default(cuid())
  profileId  String
  profile    CsProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  matches    Int       @default(0)
  wins       Int       @default(0)
  kills      Int       @default(0)
  deaths     Int       @default(0)
  capturedAt DateTime  @default(now())

  @@index([profileId, capturedAt])
}

model GalleryAlbum {
  id          String         @id @default(cuid())
  title       String
  description String?
  isPublished Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  photos      GalleryPhoto[]
}

model GalleryPhoto {
  id          String            @id @default(cuid())
  albumId     String
  album       GalleryAlbum      @relation(fields: [albumId], references: [id], onDelete: Cascade)
  storageKey  String
  imageUrl    String
  caption     String?
  status      String            @default("draft") // draft | published | rejected
  createdAt   DateTime          @default(now())
  publishedAt DateTime?
  tags        GalleryPhotoTag[]

  @@index([albumId, status])
}

model GalleryPhotoTag {
  id       String       @id @default(cuid())
  photoId  String
  photo    GalleryPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  playerId String

  @@unique([photoId, playerId])
}



model SatirePost {
  id          String    @id @default(cuid())
  templateId  String
  subjectName String
  headline    String
  body        String
  status      String    @default("draft") // draft | published | rejected
  reviewedAt  DateTime?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
}

enum Role {
  CARRY
  MID
  OFFLANE
  SOFT_SUPPORT
  HARD_SUPPORT
}

// NISHETA eSPORTS HUB — Phase 1 schema
// Расширяется в Phase 2 (Match, MatchPlayer, Hero, GameAccount) и далее.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id          String   @id @default(cuid())
  slug        String   @unique // используется в URL /players/[slug]
  nickname    String
  realName    String?
  avatarUrl   String?
  mainRole    Role?
  secondaryRoles Role[]
  steamId     String?  @unique // заполняется в Phase 2 при привязке Steam
  bio         String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Role {
  CARRY
  MID
  OFFLANE
  SOFT_SUPPORT
  HARD_SUPPORT
}

// NISHETA eSPORTS HUB — Phase 1 schema
// Расширяется в Phase 2 (Match, MatchPlayer, Hero, GameAccount) и далее.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id          String   @id @default(cuid())
  slug        String   @unique // используется в URL /players/[slug]
  nickname    String
  realName    String?
  avatarUrl   String?
  mainRole    Role?
  secondaryRoles Role[]
  steamId     String?  @unique // Steam64 ID или временно vanity-имя до первой синхронизации
  bio         String?
  availability String  @default("unknown") // unknown | today | evening | away
  availabilityUpdatedAt DateTime?
  isActive    Boolean  @default(true)
telegramChatId     String?   @unique
telegramLinkCode   String?   @unique
telegramLinkExpiry DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  matches     MatchPlayer[]
  lobbyEntries LobbyPlayer[]
gameCalls       GameCall[]
gameCallEntries GameCallPlayer[]
}
model GameCall {
  id            String   @id @default(cuid())
  game          String   // "DOTA2" | "CS2"
  creatorId     String
  creator       Player   @relation(fields: [creatorId], references: [id])
  playersNeeded Int
  startTime     DateTime
  note          String?
  status        String   @default("waiting") // waiting | ready | cancelled | expired
  createdAt     DateTime @default(now())
  participants  GameCallPlayer[]
}

model GameCallPlayer {
  id         String   @id @default(cuid())
  gameCallId String
  gameCall   GameCall @relation(fields: [gameCallId], references: [id])
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id])
  joinedAt   DateTime @default(now())

  @@unique([gameCallId, playerId])
}
model Lobby {
  id        String        @id @default(cuid())
  createdAt DateTime      @default(now())
  status    String        @default("active") // active | archived
  players   LobbyPlayer[]
}

model LobbyPlayer {
  id       String  @id @default(cuid())
  lobbyId  String
  lobby    Lobby   @relation(fields: [lobbyId], references: [id])
  playerId String
  player   Player  @relation(fields: [playerId], references: [id])
  position Int?    // 1-5
 team       String?
ready      Boolean @default(false)
heroName String?
  buildItems String?

  @@unique([lobbyId, playerId])
}

model Match {
  id         String        @id // Dota match_id как строка
  startTime  DateTime
  duration   Int           // секунды
  radiantWin Boolean
  createdAt  DateTime      @default(now())
  players    MatchPlayer[]
}

model MatchPlayer {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id])
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id])
  heroId    Int
  heroName  String
  isRadiant Boolean
  win       Boolean
  kills     Int
  deaths    Int
  assists   Int
  gpm       Int
  xpm       Int
  lastHits  Int

  @@unique([matchId, playerId])
}

enum Role {
  CARRY
  MID
  OFFLANE
  SOFT_SUPPORT
  HARD_SUPPORT
}
